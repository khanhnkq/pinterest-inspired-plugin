# =======================================================
# Pinterest Inspiration MCP Server - Environment Variables
# =======================================================

# Transport protocol: 'sse' (recommended for remote HTTP/SSE) or 'streamable-http'
MCP_TRANSPORT=sse

# Host and Port inside the container
MCP_HOST=0.0.0.0
MCP_PORT=8085

# Host binding port on the host machine (binds to localhost for security)
HOST_PORT=127.0.0.1:8085

# Internal cache directory for downloaded pin assets
PINTEREST_CACHE_DIR=/app/.pinterest_cache

# Scraper configuration
PINTEREST_RATE_LIMIT_DELAY=1.0
